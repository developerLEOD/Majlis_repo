rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthorizedFacilitator() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'araizhasan00@gmail.com' ||
        request.auth.token.email.lower() == 'thewisdomlounge1@gmail.com' ||
        request.auth.token.email.lower() == 'developertwl@gmail.com'
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if isValidId(roomId)
        && (!('roomId' in incoming()) || (incoming().roomId is string && incoming().roomId.size() <= 128))
        && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 200));
      allow delete: if isValidId(roomId);

      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isValidId(participantId)
          && (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 128));
        allow delete: if isValidId(participantId);
      }

      match /signals/{signalId} {
        allow read: if true;
        allow create: if isValidId(signalId)
          && incoming().senderId is string && incoming().senderId.size() <= 128
          && incoming().targetId is string && incoming().targetId.size() <= 128;
        allow delete: if isValidId(signalId);
      }

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidId(messageId)
          && incoming().text is string && incoming().text.size() <= 2000;
        allow delete: if isValidId(messageId);
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if isValidId(reactionId)
          && incoming().emoji is string && incoming().emoji.size() <= 16;
        allow delete: if isValidId(reactionId);
      }

      match /kicked/{kickedUserId} {
        allow read, write: if isValidId(kickedUserId);
      }
    }

    match /scheduled_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId)
        && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 200));
      allow delete: if isValidId(sessionId);
    }
  }
}
